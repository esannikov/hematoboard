    },
    {
      "id": "F004",
      "kind": "case_evidence",
      "label": "КТ-ознак збільшення бронхо-пульмональних, медіастинальних, аксилярних лімфовузлів, додаткових утворів середостіння…"
    },
    {
      "id": "F005",
      "kind": "case_evidence",
      "label": "Зліва група надключичних лімфовузлів овальної форми з нечіткими контурами, максимальним розміром 7x11 мм (без змін)…"
    },
    {
      "id": "F006",
      "kind": "case_evidence",
      "label": "Вогнищевих утворень печінки, підозрілих на neo/mts, не виявлено."
    },
    {
      "id": "F007",
      "kind": "case_evidence",
      "label": "СЕЛЕЗІНКА збільшена, 60х108х117 мм (раінше 53х106х107мм ), без обʼємно-вогнищевих змін"
    },
    {
      "id": "F008",
      "kind": "case_evidence",
      "label": "Спинний мозок не потовщений, на рівні сегмента T10-T11 зберігається вогнище підвищеної інтенсивності сигналу на Т1…"
    },
    {
      "id": "F010",
      "kind": "case_evidence",
      "label": "Спинний мозок не потовщений, на рівні сегмента T10-T11 визначаються вогнище підвищеної інтенсивності сигналу на Т1…"
    },
    {
      "id": "F011",
      "kind": "case_evidence",
      "label": "МР-ознаки в обʼємного інтрадурального інтрамедулярного утворення на рівні Т10-Т11."
    },
    {
      "id": "F012",
      "kind": "case_evidence",
      "label": "Спинний мозок не потовщений, на рівні сегмента T1O-TII визначаються вогнище підвищеної інтенсивності сигналу на ТІ…"
    },
    {
      "id": "F014",
      "kind": "case_evidence",
      "label": "на рівні сегмента Т12-L1 визначається кістозне розширення спинномозкового каналу, товщиною до 1-1,5 мм(гідроміслія)."
    },
    {
      "id": "G1",
      "kind": "critical_gap",
      "label": "Немає неврологічних симптомів, огляду й темпу клінічної динаміки; терміновість не визначена."
    },
    {
      "id": "G2",
      "kind": "critical_gap",
      "label": "Немає side-by-side DICOM-review і стандартизованого повторного вимірювання; зміна 4 мм до 7×8 мм не доведена як біо…"
    },
    {
      "id": "G3",
      "kind": "critical_gap",
      "label": "Немає повного MRI-патерну: centrality, margins, cord expansion, cyst/syrinx, GRE/SWI, diffusion і flow-voids."
    },
    {
      "id": "G6",
      "kind": "critical_gap",
      "label": "Не визначено, чи симптоми локалізуються до T10–T11 мієлопатії, а не окремої L1–L2 екструзії, і чи гідромієлія пов’я…"
    },
    {
      "id": "H1",
